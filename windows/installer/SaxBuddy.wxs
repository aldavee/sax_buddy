<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">
  <Package
      Name="Sax Buddy"
      Manufacturer="AldaveLabs"
      Version="$(var.MsiVersion)"
      UpgradeCode="E8B4A1C3-52D9-4E7A-8B31-9C4D2E6F1A85"
      Scope="perMachine"
      InstallerVersion="500">

    <SummaryInformation
        Description="Sax Buddy - Interactive Saxophone Fingering Chart, Metronome, Scales &amp; Google Drive Sync" />

    <MajorUpgrade
        DowngradeErrorMessage="A newer version of [ProductName] is already installed."
        Schedule="afterInstallInitialize" />

    <MediaTemplate EmbedCab="yes" CompressionLevel="high" />

    <Icon Id="AppIcon.ico" SourceFile="$(var.IconPath)" />
    <Property Id="ARPPRODUCTICON" Value="AppIcon.ico" />
    <Property Id="ARPURLINFOABOUT" Value="https://saxbuddy.aldavelabs.com" />

    <StandardDirectory Id="ProgramFiles6432Folder">
      <Directory Id="INSTALLFOLDER" Name="Sax Buddy" />
    </StandardDirectory>

    <StandardDirectory Id="ProgramMenuFolder">
      <Directory Id="ApplicationProgramsFolder" Name="Sax Buddy" />
    </StandardDirectory>

    <StandardDirectory Id="DesktopFolder" />

    <ComponentGroup Id="AppFiles" Directory="INSTALLFOLDER">
      <Files Include="$(var.SourceDir)\**" />
    </ComponentGroup>

    <ComponentGroup Id="Shortcuts">
      <Component Id="StartMenuShortcut" Directory="ApplicationProgramsFolder" Guid="*">
        <Shortcut
            Id="ApplicationStartMenuShortcut"
            Name="Sax Buddy"
            Description="Sax Buddy Desktop Practice Studio"
            Target="[INSTALLFOLDER]sax_buddy.exe"
            WorkingDirectory="INSTALLFOLDER"
            Icon="AppIcon.ico" />
        <RemoveFolder Id="RemoveStartMenuFolder" On="uninstall" />
        <RegistryValue
            Root="HKCU"
            Key="Software\AldaveLabs\SaxBuddy"
            Name="StartMenuShortcut"
            Type="integer"
            Value="1"
            KeyPath="yes" />
      </Component>

      <Component Id="DesktopShortcutComponent" Directory="DesktopFolder" Guid="*">
        <Shortcut
            Id="DesktopShortcut"
            Name="Sax Buddy"
            Description="Sax Buddy Desktop Practice Studio"
            Target="[INSTALLFOLDER]sax_buddy.exe"
            WorkingDirectory="INSTALLFOLDER"
            Icon="AppIcon.ico" />
        <RegistryValue
            Root="HKCU"
            Key="Software\AldaveLabs\SaxBuddy"
            Name="DesktopShortcut"
            Type="integer"
            Value="1"
            KeyPath="yes" />
      </Component>
    </ComponentGroup>

    <Feature Id="ProductFeature" Title="Sax Buddy" Level="1">
      <ComponentGroupRef Id="AppFiles" />
      <ComponentGroupRef Id="Shortcuts" />
    </Feature>
  </Package>
</Wix>
